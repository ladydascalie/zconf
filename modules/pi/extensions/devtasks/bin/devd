#!/usr/bin/env bash
# Launch the pi-devtasks daemon. Prefers mise's node to survive node upgrades,
# because mise installs a node per version and a bare `node` may drift.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if command -v mise >/dev/null 2>&1; then
  exec mise exec -- node --experimental-strip-types "$DIR/daemon.ts" "$@"
fi
exec node --experimental-strip-types "$DIR/daemon.ts" "$@"
